{
  "name": "aidas-desktop-shell",
  "private": true,
  "version": "0.1.0",
  "author": "AIDAS Team",
  "description": "Electron wrapper for AIDAS (frontend-v2 + backend only)",
  "main": "electron/main.cjs",
  "scripts": {
    "aidas:icon:build": "powershell -ExecutionPolicy Bypass -File .\\scripts\\build-aidas-ico.ps1",
    "backend:rebuild:native": "powershell -Command \"Set-Location backend; npm rebuild better-sqlite3\"",
    "desktop:build:web": "powershell -Command \"Set-Location frontend-v2; npm run build\"",
    "desktop:start": "npm run desktop:build:web && electron electron/main.cjs",
    "desktop:start:no-build": "electron electron/main.cjs",
    "db:migrate:master": "node backend/scripts/migrate-master-data.js",
    "db:build:master-only": "node backend/scripts/build-master-only-db.js",
    "desktop:dev:note": "echo Start frontend dev separately: cd frontend-v2 && npm run dev",
    "desktop:package:dir": "npm run desktop:build:web && npm run backend:rebuild:native && electron-builder --dir",
    "desktop:package:win": "powershell -ExecutionPolicy Bypass -File .\\scripts\\build-desktop-win.ps1",
    "hidro:icon:build": "powershell -ExecutionPolicy Bypass -File .\\scripts\\build-hidro-ico.ps1",
    "hidro:package:dir": "powershell -Command \"$env:CSC_IDENTITY_AUTO_DISCOVERY='false'; npm run hidro:icon:build; Remove-Item dist-hidro -Recurse -Force -ErrorAction SilentlyContinue; electron-builder --config electron-builder.hidro.json --dir\"",
    "hidro:package:win": "powershell -Command \"$env:CSC_IDENTITY_AUTO_DISCOVERY='false'; npm run hidro:icon:build; Remove-Item dist-hidro -Recurse -Force -ErrorAction SilentlyContinue; electron-builder --config electron-builder.hidro.json --win nsis --x64\"",
    "desktop:package:all:win": "powershell -Command \"npm run desktop:package:win; npm run hidro:package:win\"",
    "ivy:tray:start": "electron ivy-tray/main.cjs",
    "hidro:tray:start": "electron ivy-tray/main.cjs",
    "ivy:service:build-host": "powershell -ExecutionPolicy Bypass -File .\\ivy\\service\\build-hidro-service-host.ps1",
    "ivy:service:prepare-runtime": "powershell -ExecutionPolicy Bypass -File .\\ivy\\service\\prepare-ivy-runtime.ps1",
    "ivy:service:install": "powershell -ExecutionPolicy Bypass -File .\\ivy\\service\\install-ivy-service.ps1",
    "ivy:service:uninstall": "powershell -ExecutionPolicy Bypass -File .\\ivy\\service\\uninstall-ivy-service.ps1"
  },
  "devDependencies": {
    "electron": "^40.6.1",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.aidas.desktop",
    "productName": "Aidas",
    "toolsets": {
      "winCodeSign": "1.1.0"
    },
    "asar": true,
    "asarUnpack": [
      "electron/assets/**/*"
    ],
    "files": [
      "electron/**/*",
      "frontend-v2/dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!flora.db*",
          "!scripts/**",
          "!*.md",
          "!Anesthesia*",
          "!ICD10.xlsx"
        ]
      }
    ],
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "icon": "electron/assets/aidas-app.ico",
      "signAndEditExecutable": true,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Aidas-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "electron/assets/aidas-app.ico",
      "uninstallerIcon": "electron/assets/aidas-app.ico"
    }
  }
}
