@backend = http://localhost:3001
@his = http://10.35.202.6:8590
@hn = 1013861
@caseId = 1
@labgrp = 28

### ==================================
### AIDAS Backend - Health / Case
### ==================================
GET {{backend}}/health

###
GET {{backend}}/api/case/status


